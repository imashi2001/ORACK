# Public API base URL used by Axios (App Runner in production)
VITE_API_BASE_URL=http://localhost:5000/api

# Storefront WhatsApp Click-to-Chat number (digits only, country code included)
VITE_WHATSAPP_NUMBER=94XXXXXXXXX

# Public S3 base URL for product images (optional if API returns full URLs)
VITE_S3_PUBLIC_BASE_URL=https://your-bucket.s3.amazonaws.com
