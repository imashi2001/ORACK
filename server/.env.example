NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orack?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=1d

# Admin bootstrap (used only for first admin seed / setup)
ADMIN_EMAIL=admin@orack.local
ADMIN_PASSWORD=change-me

# Amazon S3 (product images + customization reference uploads)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=orack-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Business WhatsApp number stored as default; overridable from admin settings
DEFAULT_WHATSAPP_NUMBER=94XXXXXXXXX
MAX_UPLOAD_MB=8
