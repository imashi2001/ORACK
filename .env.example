# Copy to .env (local) and set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# ── Database (Neon PostgreSQL) ──────────────────────────────────
# Pooled connection (host contains "-pooler"): used by the app at runtime AND at build time
# (the storefront is prerendered from the database).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/orack?sslmode=require"
# Direct (non-pooled) connection: used by Prisma CLI for migrations and seeding.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/orack?sslmode=require"

# ── Public storefront ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Fallback only. The real WhatsApp number is set in Admin → Settings.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# ── Cloudflare R2 ───────────────────────────────────────────────
# Product photos (public bucket). Leave blank to keep using placeholder artwork.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BUCKET="orack-public"
# Public URL of the bucket: an r2.dev URL or a custom domain such as https://images.your-domain
R2_PUBLIC_BASE_URL=""
# Customer reference images (private bucket — never make it public)
R2_PRIVATE_BUCKET="orack-private"
# Optional: S3-compatible endpoint for local development (e.g. MinIO). Leave blank for Cloudflare R2.
R2_ENDPOINT=""

# ── First admin account (only read by `npm run admin:create`) ───
# ADMIN_EMAIL="you@your-domain"
# ADMIN_PASSWORD="a long passphrase, 10+ characters"
# ADMIN_NAME="Your Name"
# ADMIN_ROLE="OWNER"   # OWNER | ADMIN | STAFF
